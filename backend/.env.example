# Backend & Cloud Streaming Worker Environment Variables
# NEVER place these values in the Android APK or root .env!

PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://admin.techlive.cloud

# PostgreSQL & Redis
DATABASE_URL=postgresql://techlive_user:CHANGE_ME@localhost:5432/techlive
REDIS_URL=redis://localhost:6379

# 32-byte hex key for AES-256-GCM encryption of RTMP stream keys & OAuth tokens
STREAM_KEY_ENCRYPTION_KEY=

# Firebase Admin SDK (ID Token verification + FCM push notifications)
FIREBASE_PROJECT_ID=gen-lang-client-0835454657
FIREBASE_SERVICE_ACCOUNT_JSON=

# S3-Compatible Cloud Object Storage (1 GB resumable video uploads)
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=techlive-videos-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Official Platform OAuth Integrations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.techlive.cloud/v1/oauth/youtube/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.techlive.cloud/v1/oauth/facebook/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.techlive.cloud/v1/oauth/tiktok/callback

# Payment Gateways (Server-side only)
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_BASE_URL=https://api.mynagad.com
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
